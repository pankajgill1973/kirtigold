# Copy to .env locally or set these values in your hosting provider's environment settings.
# Use a unique password of at least 12 characters; never commit the real value.
ADMIN_PASSWORD=replace-with-a-long-unique-secret
# Optional comma-separated origins only if a separate frontend requires cross-origin API access.
# Example: https://www.example.com,https://admin.example.com
ALLOWED_ORIGINS=
PORT=3000
